# Supabase Configuration
# Get from: https://app.supabase.com/project/{id}/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Server Configuration
PORT=3001

# M-Pesa Configuration (Daraja API 2.0)
# Get from: https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_USE_SANDBOX=true

# SMTP Email Configuration
# For Gmail use an App Password: https://support.google.com/accounts/answer/185833
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=PEAKS HOTEL NANYUKI
HOTEL_EMAIL=hotel@yourdomain.com

# Supabase Configuration
# Get these from your Supabase project settings
# https://app.supabase.com/project/{your-project-id}/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server Configuration
PORT=3001

# M-Pesa Configuration (Daraja API 2.0)
# Get these from your Safaricom Developer Portal
# https://developer.safaricom.co.ke/

MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode (e.g., 174379 for test)
MPESA_PASSKEY=your-passkey (from developer portal)
MPESA_INITIATOR_NAME=your-initiator-name
MPESA_SECURITY_CREDENTIAL=your-security-credential (encrypted base64 password)
MPESA_CALLBACK_URL=http://localhost:3001/api/mpesa/callback
MPESA_USE_SANDBOX=true # Set to false for production, true for sandbox testing

# Paystack Configuration
# Get these from your Paystack Dashboard
# https://dashboard.paystack.com/#/settings/developers

PAYSTACK_SECRET_KEY=sk_test_your-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-public-key

# Notification Webhook (optional)
# If you have a webhook endpoint for payment notifications
NOTIFICATIONS_WEBHOOK=https://your-webhook.com/notify
